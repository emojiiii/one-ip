# SvelteKit generates per-page CSP hashes in the HTML; frame-ancestors must be a response header.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), clipboard-read=(self), clipboard-write=(self), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
