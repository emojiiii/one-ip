{
  "name": "ip",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "version": "26.922.1906",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir migration/sveltekit dev",
    "deploy": "wrangler deploy --env=\"\"",
    "build": "pnpm --dir migration/sveltekit check && pnpm --dir migration/sveltekit build",
    "build:docker": "pnpm build && node scripts/build-server.mjs docker",
    "start": "node .output/server.mjs",
    "worker:dev": "node scripts/worker-dev.mjs",
    "worker:types": "wrangler types",
    "test": "wrangler deploy --dry-run --env=\"\" --outdir .worker-test && node --import ./tests/register-paths.mjs --test tests/*.test.mjs",
    "lint": "oxlint",
    "preview": "pnpm --dir migration/sveltekit preview",
    "format": "prettier --write .",
    "prepare": "husky",
    "browser:build": "node scripts/build-browser-diagnostics.mjs"
  },
  "dependencies": {
    "@cloudflare/speedtest": "1.14.2",
    "@fingerprintjs/fingerprintjs": "5.3.0",
    "@lucide/svelte": "^1.72.0",
    "bits-ui": "^2.21.0",
    "i18next": "26.6.0",
    "leaflet": "1.9.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "rollup": "4.64.10",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wrangler": "4.151.2"
  },
  "description": "IP diagnostics with SvelteKit and Cloudflare Workers",
  "keywords": [
    "sveltekit",
    "svelte",
    "vite",
    "cloudflare-workers"
  ],
  "lint-staged": {
    "**/*.{js,ts,svelte,json,css,md}": [
      "prettier --write"
    ]
  }
}
